# Tiger Cloud connection string. Use the pooled one on Vercel. See docs/database/README.md
DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
GEMINI_API_KEY=
# ElevenLabs key restricted to Text to Speech, Speech to Text and User. Server-only.
ELEVENLABS_API_KEY=
# Viva's voice (Voice Library → copy voice ID). Optional: falls back to a stock voice.
ELEVENLABS_VOICE_ID=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# Google Calendar from the browser (OAuth Web client ID; see README). Optional.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shared demo calendar (the student's Google Calendar, connected for every visitor; no OAuth screen).
# Service account key file contents on one line, and the calendar id (the account's email for its primary calendar).
# The calendar must be shared with the service account's email with "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TZ=America/New_York
# Dev only: GOOGLE_FAKE_CALENDAR=1 runs an in-memory calendar so the whole flow works with no Google account.

# Study Pots on Solana devnet (docs/solana/README.md). `npm run sol:keys` and `npm run sol:mint` fill these locally.
SOLANA_AUTHORITY_SECRET=
WALLET_ENCRYPTION_KEY=
PATH_MINT=
# Optional: dedicated devnet RPC (server) and websocket reads (browser). Default: public devnet.
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=
